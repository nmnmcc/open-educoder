{
  "name": "open-educoder",
  "version": "0.1.0",
  "description": "Local CLI for authenticated Educoder workflows.",
  "type": "module",
  "bin": "./dist/index.mjs",
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://github.com/nmnmcc/open-educoder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nmnmcc/open-educoder.git"
  },
  "bugs": {
    "url": "https://github.com/nmnmcc/open-educoder/issues"
  },
  "keywords": [
    "educoder",
    "cli"
  ],
  "license": "AGPL-3.0-only",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "tsdown",
    "prepack": "yarn check && yarn build",
    "format": "prettier -w .",
    "pack:dry-run": "yarn pack --dry-run",
    "publish:dry-run": "yarn npm publish --dry-run",
    "cli": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "check": "yarn tsc"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@effect/opentelemetry": "^4.0.0-rc.111",
    "@effect/platform-node": "^4.0.0-rc.111",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "effect": "^4.0.0-rc.111",
    "md4x": "^0.0.29",
    "mustache": "^4.2.0",
    "proxy-agent": "^8.0.2",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
